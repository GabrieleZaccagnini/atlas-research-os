# Server-only. Never prefix provider keys with NEXT_PUBLIC_.
# CoinGecko Demo key: free registration required; absent key produces missing_key.
COINGECKO_DEMO_API_KEY=
ATLAS_COINGECKO_ENABLED=true
ATLAS_DEXSCREENER_ENABLED=true
ATLAS_DEFILLAMA_ENABLED=true
# Public personal-use market feed; no key. Cached for five minutes.
ATLAS_COINPAPRIKA_ENABLED=true
ATLAS_API_TIMEOUT_MS=8000
# Additional stale lifetime after the endpoint fresh TTL expires.
ATLAS_STALE_TTL_MS=300000
ATLAS_CACHE_MAX_ENTRIES=250

# Supabase public browser configuration (publishable key only, never service-role).
# Leave BOTH blank for browser-only mode. Rebuild after configuring.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Key-free dashboard sources (set false to disable).
ATLAS_FRED_ENABLED=true
ATLAS_ALTERNATIVE_ENABLED=true
ATLAS_NEWS_ENABLED=true

# CMC uses official public endpoints without a key. Optional free Basic key:
CMC_API_KEY=
ATLAS_CMC_ENABLED=true
# Cointelegraph and ECB RSS use ATLAS_NEWS_ENABLED. No news key required.

# CMC 4h/12h changes require a configured key with historical-price access.
# Keyless listings do not include these windows; no history request is made without a key.
